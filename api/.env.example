# Cloudflare R2 — armazenamento das fotos dos produtos (protocolo S3).
# Este arquivo e so referencia e entra no repositorio SEM valores.
# Copie para api/.env e preencha la. O api/.env nunca e versionado.
# Use valores simples, sem aspas e sem espacos ao redor do "=".

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=forma3d-imagens
R2_PUBLIC_URL=
